<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingWPDLHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BingWPDLHelper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="必应壁纸下载器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Storyboard x:Key="SelMoveAnimation">
                <!-- placeholder; animation controlled from code-behind by Beginning animations on SelTransform.X and Sel.Width -->
            </Storyboard>
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent 风格自定义标题栏 -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 左侧放置折叠按钮、预留空位及拖拽区域 -->
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CollapseNavButton" Grid.Column="0" Click="CollapseNavButton_Click" Style="{StaticResource CaptionButtonStyle}" ToolTipService.ToolTip="收起/展开目录">
                        <FontIcon Glyph="≡" FontFamily="Segoe UI Symbol" />
                    </Button>
                    <StackPanel Grid.Column="0" Width="12" /> <!-- 空位，后续放图标 -->

                    <Grid x:Name="DragRegion" Grid.Column="1" IsHitTestVisible="False">
                        <TextBlock Text="必应壁纸下载器"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />
                    </Grid>
                </Grid>

                <!-- 右侧按钮组：切换按钮 + 自定义系统按钮（最小化/最大化/关闭） -->
                <StackPanel x:Name="CaptionHost" Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,160,0">
                    <Button x:Name="ToggleThemeButton"
                            Click="ToggleThemeButton_Click"
                            ToolTipService.ToolTip="切换深浅模式"
                            Style="{StaticResource CaptionButtonStyle}">
                        <FontIcon x:Name="ToggleIcon" Glyph="☀" FontFamily="Segoe UI Symbol" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- 主内容区：今日壁纸界面（圆角图片 + 分辨率切换） -->
            <Grid Margin="8,8,12,12">
                <Grid.ColumnDefinitions>
                    <!-- 左侧列使用 Auto，让 NavigationView 在展开/折叠时控制自身宽度 -->
                    <ColumnDefinition x:Name="LeftColumn" Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="8" Margin="0,0,8,0" VerticalAlignment="Stretch">
                    <!-- 使用 WinUI Gallery 风格的 NavigationView 布局：显示 PaneHeader，启用内置 ToggleButton（用于折叠/展开） -->
                    <NavigationView x:Name="NavView" PaneDisplayMode="Left" IsPaneOpen="True" SelectionChanged="NavView_SelectionChanged" CompactPaneLength="48" OpenPaneLength="240" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False">
                        <NavigationView.PaneHeader>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,4">
                                <Border Width="36" Height="36" Background="{ThemeResource SystemControlBackgroundAccentBrush}" CornerRadius="8">
                                    <TextBlock Text="B" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="必应壁纸" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                            </StackPanel>
                        </NavigationView.PaneHeader>
                        <NavigationView.MenuItems>
                            <NavigationViewItem Content="今日壁纸" Tag="0">
                                <NavigationViewItem.Icon>
                                    <SymbolIcon Symbol="Home" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="下载壁纸" Tag="1">
                                <NavigationViewItem.Icon>
                                    <SymbolIcon Symbol="Download" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="设置壁纸" Tag="2">
                                <NavigationViewItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7F4;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="软件设置" Tag="3">
                                <NavigationViewItem.Icon>
                                    <SymbolIcon Symbol="Setting" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="关于" Tag="4">
                                <NavigationViewItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" />
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                    </NavigationView>
                </Border>
                <!-- 今日壁纸界面：圆角图片 + 圆角分辨率切换条 -->
                <Grid Grid.Column="1">
                    <!-- TodayHost and DownloadHost are sibling panels; switch Visibility from code-behind -->
                    <Grid x:Name="TodayHost" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Margin="5" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
                            <Image x:Name="MainImage" Stretch="UniformToFill" />
                        </Border>

                        <!-- 图片名称 -->
                        <TextBlock x:Name="ImageTitle" Grid.Row="1" Text="" HorizontalAlignment="Center" Margin="8,8,8,0" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

                        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="12,28,12,12">
                            <Border CornerRadius="16" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
                                <Grid x:Name="SegGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 指示器放在最底层，占据按钮下方，通过 TranslateTransform 移动 -->
                                    <Border x:Name="SelIndicator" Background="{ThemeResource SystemControlHighlightAccentBrush}" CornerRadius="12" Opacity="1.0" HorizontalAlignment="Left" VerticalAlignment="Stretch" Margin="6,6,6,6">
                                        <Border.RenderTransform>
                                            <TranslateTransform x:Name="SelTransform" X="0" />
                                        </Border.RenderTransform>
                                    </Border>

                                    <Button x:Name="Btn720" Grid.Column="0" Content="720P" Click="Seg_Click" Padding="12,6" Background="Transparent" BorderThickness="0" />
                                    <Button x:Name="Btn1080" Grid.Column="1" Content="1080P" Click="Seg_Click" Padding="12,6" Background="Transparent" BorderThickness="0" />
                                    <Button x:Name="BtnUHD" Grid.Column="2" Content="UHD (4K)" Click="Seg_Click" Padding="12,6" Background="Transparent" BorderThickness="0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 下载壁纸页面（准备中） -->
                    <ScrollViewer x:Name="DownloadHost" Visibility="Collapsed" Margin="8">
                        <StackPanel>
                            <TextBlock Text="下载壁纸" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="下载目录：" VerticalAlignment="Center" Grid.Column="0" />
                                <TextBox x:Name="DownloadFolderText" Grid.Column="1" IsReadOnly="False" Width="420" Margin="8,0" KeyDown="DownloadFolderText_KeyDown" />
                                <Button Grid.Column="2" Click="OpenFolderPicker_Click" ToolTipService.ToolTip="选择文件夹" Style="{StaticResource CaptionButtonStyle}" Margin="8,0,0,0">
                                    <FontIcon Glyph="📁" FontFamily="Segoe UI Emoji" />
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="默认清晰度：" VerticalAlignment="Center" />
                                <ComboBox x:Name="DownloadResolutionCombo" Width="200" Margin="8,0" SelectedIndex="2">
                                    <ComboBoxItem Content="720P" Tag="_1280x720.jpg" />
                                    <ComboBoxItem Content="1080P" Tag="_1920x1080.jpg" />
                                    <ComboBoxItem Content="UHD (4K)" Tag="_UHD.jpg" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <CheckBox x:Name="DownloadHistoryCheck" Content="下载历史壁纸" Checked="DownloadHistoryCheck_Checked" Unchecked="DownloadHistoryCheck_Unchecked" />
                                <TextBlock Text=" 最大天数：" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <NumberBox x:Name="MaxDaysNumberBox" Minimum="1" Maximum="365" Value="7" Width="80" IsEnabled="False" />
                            </StackPanel>

                            <Button Content="开始下载" Click="StartDownloadButton_Click" Width="120" Margin="0,8,0,0" />

                            <TextBlock x:Name="DownloadStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 设置壁纸 页面 -->
                    <Grid x:Name="SettingsHost" Visibility="Collapsed" Margin="8">
                        <StackPanel>
                            <TextBlock Text="设置壁纸" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="幻灯片目录：" VerticalAlignment="Center" />
                                <TextBox x:Name="SlideshowFolderText" Width="420" Margin="8,0" IsReadOnly="False" />
                                <Button Click="OpenFolderPicker_Click" ToolTipService.ToolTip="选择文件夹" Style="{StaticResource CaptionButtonStyle}" Margin="8,0,0,0">
                                    <FontIcon Glyph="📁" FontFamily="Segoe UI Emoji" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="切换间隔（秒）：" VerticalAlignment="Center" />
                                <NumberBox x:Name="SlideshowInterval" Minimum="1" Maximum="86400" Value="1800" Width="120" Margin="8,0" />
                                <CheckBox x:Name="ShuffleCheck" Content="乱序" Margin="12,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Text="填充方式：" VerticalAlignment="Center" />
                                <ComboBox x:Name="FillModeCombo" Width="240" Margin="8,0" SelectedIndex="4">
                                    <ComboBoxItem Content="Center" Tag="Center" />
                                    <ComboBoxItem Content="Tile" Tag="Tile" />
                                    <ComboBoxItem Content="Stretch" Tag="Stretch" />
                                    <ComboBoxItem Content="Fit" Tag="Fit" />
                                    <ComboBoxItem Content="Fill" Tag="Fill" />
                                    <ComboBoxItem Content="Span" Tag="Span" />
                                </ComboBox>
                            </StackPanel>

                            <CheckBox x:Name="SetAccentCheck" Content="将壁纸颜色设置为系统主题色" Margin="0,0,0,8" />

                            <Button Content="应用到系统" Click="ApplySlideshowButton_Click" Width="140" Margin="0,8,0,0" />

                            <TextBlock x:Name="SettingsStatusText" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
