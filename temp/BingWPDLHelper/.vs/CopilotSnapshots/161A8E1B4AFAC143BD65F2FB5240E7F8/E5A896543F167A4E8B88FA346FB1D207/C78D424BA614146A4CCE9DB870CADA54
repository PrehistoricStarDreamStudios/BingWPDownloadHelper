                if (target != null)
                {
                    var pt = target.TransformToVisual(segGrid).TransformPoint(new Windows.Foundation.Point(0, 0));
                    double overlapAdjustment = 0;
                    if (target == (root?.FindName("B1080") as FrameworkElement)) overlapAdjustment = -2;
                    if (target == (root?.FindName("BUHD") as FrameworkElement)) overlapAdjustment = -4;

                    double innerWidth = target.ActualWidth;
