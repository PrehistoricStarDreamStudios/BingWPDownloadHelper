        }

        private async void ChangeDownloadFolder_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var root = this.Content as FrameworkElement;
                var dlg = new ContentDialog { Title = "更改下载目录", PrimaryButtonText = "确定", CloseButtonText = "取消" };
                var tb = new TextBox { Text = WallpaperFolderPath, Width = 480 };
                dlg.Content = tb;
                var res = await dlg.ShowAsync();
                if (res == ContentDialogResult.Primary)
                {
                    var newPath = tb.Text.Trim();
                    if (string.IsNullOrEmpty(newPath)) return;
                    if (!Path.IsPathRooted(newPath)) newPath = Path.GetFullPath(newPath);

                    // 检查写入权限（通过尝试在目录中创建临时文件）
                    try
                    {
                        if (!Directory.Exists(newPath)) Directory.CreateDirectory(newPath);
                        var tmp = Path.Combine(newPath, ".wpdl_test_write.tmp");
                        File.WriteAllText(tmp, "test");
                        File.Delete(tmp);
                    }
                    catch (Exception ex)
                    {
                        var status = root?.FindName("DownloadStatusText") as TextBlock;
                        if (status != null) status.Text = "没有对所选目录的写入权限：" + ex.Message;
                        return;
                    }

                    // move existing files
                    try
                    {
                        foreach (var f in Directory.GetFiles(WallpaperFolderPath))
                        {
                            var dest = Path.Combine(newPath, Path.GetFileName(f));
                            if (File.Exists(dest)) continue;
                            File.Move(f, dest);
                        }
                    }
                    catch { }

                    WallpaperFolderPath = newPath;
                    _config["download_folder"] = newPath;
                    try { File.WriteAllLines(ConfigFilePath, _config.Select(kv => kv.Key + "=" + kv.Value)); } catch { }

                    var dlText = root?.FindName("DownloadFolderText") as TextBox;
                    if (dlText != null) dlText.Text = WallpaperFolderPath;
                }
            }
            catch { }
        }

