        private async void StartDownloadButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var root = this.Content as FrameworkElement;
                var status = root?.FindName("DownloadStatusText") as TextBlock;
                var btn = sender as Button;
                if (btn != null) btn.IsEnabled = false;
                if (status != null) status.Text = "正在下载...";

                bool downloadHistory = false;
                var chk = root?.FindName("DownloadHistoryCheck") as CheckBox;
                if (chk != null) downloadHistory = chk.IsChecked == true;

                var dlCombo = root?.FindName("DownloadResolutionCombo") as ComboBox;
                var tag = "_UHD.jpg";
                if (dlCombo != null && dlCombo.SelectedItem is ComboBoxItem cbi && cbi.Tag is string t) tag = t;

                using var http = new System.Net.Http.HttpClient();
                int downloaded = 0;

                if (downloadHistory)
                {
                    var nb = root?.FindName("MaxDaysNumberBox") as NumberBox;
                    int max = (nb != null) ? (int)nb.Value : 7;
                    var listPath = Path.Combine(AppContext.BaseDirectory, "Assets", "list.txt");
                    if (!File.Exists(listPath))
                    {
                        if (status != null) status.Text = "未找到 Assets\\list.txt";
                    }
                    else
                    {
                        var lines = File.ReadAllLines(listPath).Where(x => !string.IsNullOrWhiteSpace(x)).ToArray();
                        var toDl = lines.Take(max);
                        foreach (var u in toDl)
                        {
                            try
                            {
                                var url = u.Trim();
                                var uri = new Uri(url);
                                var name = Path.GetFileName(uri.LocalPath);
                                var dest = Path.Combine(WallpaperFolderPath, name);
                                if (File.Exists(dest)) { downloaded++; continue; }
                                var data = await http.GetByteArrayAsync(uri);
                                File.WriteAllBytes(dest, data);
                                downloaded++;
                            }
                            catch (Exception ex) { }
                        }
                        if (status != null) status.Text = $"已下载 {downloaded} 张到 {WallpaperFolderPath}";
                    }
                }
                else
                {
                    var mainImg = root?.FindName("MainImage") as Microsoft.UI.Xaml.Controls.Image;
                    if (mainImg?.Source is Microsoft.UI.Xaml.Media.Imaging.BitmapImage bi && bi.UriSource != null)
                    {
                        try
                        {
                            var uri = bi.UriSource;
                            var ext = Path.GetExtension(uri.AbsolutePath);
                            if (string.IsNullOrEmpty(ext)) ext = ".jpg";
                            var fileName = "bing_" + DateTime.Now.ToString("yyyyMMdd_HHmmss") + ext;
                            var dest = Path.Combine(WallpaperFolderPath, fileName);
                            if (!File.Exists(dest))
                            {
                                var data = await http.GetByteArrayAsync(uri);
                                File.WriteAllBytes(dest, data);
                                downloaded = 1;
                            }
                            if (status != null) status.Text = $"已下载 {downloaded} 张到 {WallpaperFolderPath}";
                        }
                        catch { if (status != null) status.Text = "下载失败"; }
                    }
                }

                if (btn != null) btn.IsEnabled = true;
            }
            catch { }
        }

    }
