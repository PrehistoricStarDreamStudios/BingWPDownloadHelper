<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingWPDLHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BingWPDLHelper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="必应壁纸下载器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent 风格自定义标题栏 -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 可拖动的区域，仅在此区域拖动窗口 -->
                <Grid x:Name="DragRegion" Grid.Column="0" IsHitTestVisible="False">
                    <TextBlock Text="必应壁纸下载器"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </Grid>

                <!-- 右侧按钮组：切换按钮 + 自定义系统按钮（最小化/最大化/关闭） -->
                <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,120,0">
                    <Button x:Name="ToggleThemeButton"
                            Click="ToggleThemeButton_Click"
                            ToolTipService.ToolTip="切换深浅模式"
                            Width="36"
                            Height="28"
                            Padding="6"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                        <FontIcon x:Name="ToggleIcon" Glyph="☀" FontFamily="Segoe UI Symbol" FontSize="14" />
                    </Button>

                    <Button x:Name="MinButton" Click="MinButton_Click" Width="36" Height="28" Padding="6" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                        <TextBlock Text="─" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button x:Name="MaxButton" Click="MaxButton_Click" Width="36" Height="28" Padding="6" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                        <TextBlock Text="▢" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" Width="36" Height="28" Padding="6" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                        <TextBlock Text="✕" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- 主内容区，按需填充 -->
        </Grid>

    </Grid>
</Window>
