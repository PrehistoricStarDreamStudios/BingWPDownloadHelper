using Microsoft.UI.Xaml;
using Microsoft.UI.Xaml.Controls;
using System;
using System.Net.Http;
using System.Text.Json;
using System.Threading.Tasks;
using Microsoft.UI.Xaml.Media.Animation;

namespace BingWPDLHelper
{
    public sealed partial class TodayPage : UserControl
    {
        private readonly HttpClient _http = new HttpClient();
        private string _baseUrl = "";

        public TodayPage()
        {
            this.InitializeComponent();
            _ = LoadWallpaperAsync();
            // 延迟初始化选中指示器
            this.Loaded += TodayPage_Loaded;
        }

        private void TodayPage_Loaded(object sender, RoutedEventArgs e)
        {
            // 默认选中 UHD
            SetSelectedSegment(BUHD);
            ApplySelectedOpacity(true);
        }

        private async Task LoadWallpaperAsync()
        {
            try
            {
                var url = "https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=en-US";
                var s = await _http.GetStringAsync(url);
                using var doc = JsonDocument.Parse(s);
                var images = doc.RootElement.GetProperty("images");
                if (images.GetArrayLength() > 0)
                {
                    var first = images[0];
                    var urlBase = first.GetProperty("urlbase").GetString();
                    if (!string.IsNullOrEmpty(urlBase))
                    {
                        _baseUrl = "https://www.bing.com" + urlBase;
                        // 默认加载 UHD
                        await DispatcherQueue.TryEnqueueAsync(() => { SetImageResolution("UHD"); return Task.CompletedTask; });
                    }
                }
            }
            catch { }
        }

        private void SetImageResolution(string res)
        {
            try
            {
                string suffix = res switch
                {
                    "720" => "_1280x720.jpg",
                    "1080" => "_1920x1080.jpg",
                    _ => "_UHD.jpg",
                };
                var full = _baseUrl + suffix;
                MainImage.Source = new Microsoft.UI.Xaml.Media.Imaging.BitmapImage(new Uri(full));
            }
            catch { }
        }

        private void Seg_Click(object sender, RoutedEventArgs e)
        {
            if (sender == Btn720) { SetSelectedSegment(B720); SetImageResolution("720"); }
            else if (sender == Btn1080) { SetSelectedSegment(B1080); SetImageResolution("1080"); }
            else { SetSelectedSegment(BUHD); SetImageResolution("UHD"); }
        }

        private void SetSelectedSegment(Border target)
        {
            try
            {
                // 计算目标位置与宽度
                var transform = target.TransformToVisual(SegGrid);
                var pt = transform.TransformPoint(new Windows.Foundation.Point(0, 0));
                double width = target.ActualWidth;
                // 应用到 SelIndicator
                SelIndicator.Width = width;
                Canvas.SetLeft(SelIndicator, pt.X);
                SelIndicator.Opacity = 1.0;
            }
            catch { }
        }

        private void ApplySelectedOpacity(bool on)
        {
            SelIndicator.Opacity = on ? 1.0 : 0.0;
        }
    }
}
