<UserControl
    x:Class="BingWPDLHelper.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 图片容器，圆角并与页面边缘保持 5px 间距 -->
        <Border Margin="5" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
            <Image x:Name="MainImage" Stretch="UniformToFill" />
        </Border>

        <!-- 分辨率切换条（圆角的 segmented control） -->
        <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="12" >
            <Border CornerRadius="16" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
                <Grid x:Name="SegGrid" ColumnDefinitions="Auto,Auto,Auto">
                    <!-- 选中指示器 -->
                    <Border x:Name="SelIndicator" Background="{ThemeResource SystemControlHighlightAccentBrush}" CornerRadius="12" Opacity="0.0" HorizontalAlignment="Left" VerticalAlignment="Stretch" RenderTransformOrigin="0,0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="SelTransform" X="0" />
                        </Border.RenderTransform>
                    </Border>

                    <Border x:Name="B720" Grid.Column="0" CornerRadius="12,0,0,12" Background="Transparent">
                        <Button x:Name="Btn720" Content="720P" Click="Seg_Click" Padding="16,6" Background="Transparent" BorderThickness="0" />
                    </Border>

                    <Border x:Name="B1080" Grid.Column="1" CornerRadius="0" Background="Transparent" Margin="-2,0">
                        <Button x:Name="Btn1080" Content="1080P" Click="Seg_Click" Padding="18,6" Background="Transparent" BorderThickness="0" />
                    </Border>

                    <Border x:Name="BUHD" Grid.Column="2" CornerRadius="0,12,12,0" Background="Transparent" Margin="-2,0">
                        <Button x:Name="BtnUHD" Content="UHD (4K)" Click="Seg_Click" Padding="16,6" Background="Transparent" BorderThickness="0" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
