<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingWPDLHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BingWPDLHelper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="必应壁纸下载器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent 风格自定义标题栏 -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 可拖动的区域，仅在此区域拖动窗口 -->
                <Grid x:Name="DragRegion" Grid.Column="0" IsHitTestVisible="False">
                    <TextBlock Text="必应壁纸下载器"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                               FontSize="14"
                               FontWeight="SemiBold" />
                </Grid>

                <!-- 右侧按钮组：切换按钮 + 自定义系统按钮（最小化/最大化/关闭） -->

                <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,8,0">
                    <Button x:Name="ToggleThemeButton"
                            Click="ToggleThemeButton_Click"
                            ToolTipService.ToolTip="切换深浅模式"
                            Style="{StaticResource CaptionButtonStyle}">
                        <FontIcon x:Name="ToggleIcon" Glyph="☀" FontFamily="Segoe UI Symbol" FontSize="14" />
                    </Button>

                    <Button x:Name="MinButton" Click="MinButton_Click" ToolTipService.ToolTip="最小化" Style="{StaticResource CaptionButtonStyle}">
                        <TextBlock Text="─" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button x:Name="MaxButton" Click="MaxButton_Click" ToolTipService.ToolTip="最大化" Style="{StaticResource CaptionButtonStyle}">
                        <TextBlock x:Name="MaxIcon" Text="▢" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                    <Button x:Name="CloseButton" Click="CloseButton_Click" ToolTipService.ToolTip="关闭" Style="{StaticResource CloseCaptionButtonStyle}">
                        <TextBlock x:Name="CloseIcon" Text="✕" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- 主内容区：今日壁纸界面（圆角图片 + 分辨率切换） -->
            <Grid Margin="8,8,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Background="Transparent" Padding="8" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="目录"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                   Margin="0,0,0,8" />
                        <ListBox x:Name="LeftNavList" SelectionMode="Single" SelectedIndex="0" Background="Transparent" BorderThickness="0" SelectionChanged="LeftNavList_SelectionChanged">
                            <ListBoxItem Content="今日壁纸" />
                            <ListBoxItem Content="下载壁纸" />
                            <ListBoxItem Content="设置壁纸" />
                            <ListBoxItem Content="软件设置" />
                            <ListBoxItem Content="关于" />
                        </ListBox>
                    </StackPanel>
                </Border>
                <!-- 今日壁纸界面：圆角图片 + 圆角分辨率切换条 -->
                <Grid x:Name="TodayHost" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Margin="5" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
                        <Image x:Name="MainImage" Stretch="UniformToFill" />
                    </Border>

                    <Grid Grid.Row="1" HorizontalAlignment="Center" Margin="12">
                        <Border CornerRadius="16" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
                            <Grid x:Name="SegGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelIndicator" Background="{ThemeResource SystemControlHighlightAccentBrush}" CornerRadius="12" Opacity="0.0" HorizontalAlignment="Left" VerticalAlignment="Stretch" RenderTransformOrigin="0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="SelTransform" X="0" />
                                    </Border.RenderTransform>
                                </Border>

                                <Border x:Name="B720" Grid.Column="0" CornerRadius="12,0,0,12" Background="Transparent">
                                    <Button x:Name="Btn720" Content="720P" Click="Seg_Click" Padding="16,6" Background="Transparent" BorderThickness="0" />
                                </Border>

                                <Border x:Name="B1080" Grid.Column="1" CornerRadius="0" Background="Transparent" Margin="-2,0">
                                    <Button x:Name="Btn1080" Content="1080P" Click="Seg_Click" Padding="18,6" Background="Transparent" BorderThickness="0" />
                                </Border>

                                <Border x:Name="BUHD" Grid.Column="2" CornerRadius="0,12,12,0" Background="Transparent" Margin="-2,0">
                                    <Button x:Name="BtnUHD" Content="UHD (4K)" Click="Seg_Click" Padding="16,6" Background="Transparent" BorderThickness="0" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </Grid>
</Window>
