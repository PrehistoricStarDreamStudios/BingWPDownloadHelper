namespace BingWPDLHelper
{
    /// <summary>
    /// An empty window that can be used on its own or navigated to within a Frame.
    /// </summary>
    public sealed partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();

            // 获取主显示器分辨率
            int screenWidth = GetSystemMetrics(0); // SM_CXSCREEN
            int screenHeight = GetSystemMetrics(1); // SM_CYSCREEN

            int longSide = Math.Max(screenWidth, screenHeight);
            int shortSide = Math.Min(screenWidth, screenHeight);

            // 按照要求：长的50% * 宽的60%
            double targetWidth = Math.Round(longSide * 0.5);
            double targetHeight = Math.Round(shortSide * 0.6);

            this.Width = targetWidth;
            this.Height = targetHeight;
        }

        [DllImport("user32.dll")]
        private static extern int GetSystemMetrics(int nIndex);
    }
}
