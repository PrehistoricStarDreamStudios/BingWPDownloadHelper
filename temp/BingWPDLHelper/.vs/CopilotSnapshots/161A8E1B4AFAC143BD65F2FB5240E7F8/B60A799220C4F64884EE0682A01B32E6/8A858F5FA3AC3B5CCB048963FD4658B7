    /// <summary>
    /// An empty window that can be used on its own or navigated to within a Frame.
    /// </summary>
    public sealed partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();

            // 在初始化后立刻设置自定义标题栏为拖动区域
            try
            {
                var rootInit = this.Content as FrameworkElement;
                var dragRegionInit = rootInit?.FindName("DragRegion") as UIElement;
                if (dragRegionInit != null)
                {
                    this.SetTitleBar(dragRegionInit);
                }
                var toggleInit = rootInit?.FindName("ToggleThemeButton") as Button;
                if (toggleInit != null)
                {
                    toggleInit.IsHitTestVisible = true;
                }
            }
            catch { }

            // 获取主显示器分辨率
            int screenWidth = GetSystemMetrics(0); // SM_CXSCREEN
            int screenHeight = GetSystemMetrics(1); // SM_CYSCREEN

            int longSide = Math.Max(screenWidth, screenHeight);
            int shortSide = Math.Min(screenWidth, screenHeight);

            // 按照要求：长的50% * 宽的60%
            int targetWidth = (int)Math.Round(longSide * 0.5);
            int targetHeight = (int)Math.Round(shortSide * 0.6);

            // WinUI Window 不直接暴露 Width/Height，使用 WinRT.Interop 获取 HWND 并调用 SetWindowPos 设置尺寸
            var hwnd = WinRT.Interop.WindowNative.GetWindowHandle(this);
            const uint SWP_NOZORDER = 0x0004;
            const uint SWP_NOMOVE = 0x0002;
            SetWindowPos(hwnd, IntPtr.Zero, 0, 0, targetWidth, targetHeight, SWP_NOZORDER | SWP_NOMOVE);

            // 扩展内容到标题栏并使用自定义标题栏作为可拖动区域
            this.ExtendsContentIntoTitleBar = true;
            // 在窗口激活后设置 TitleBar，使用运行时查找以避免对生成字段的编译时引用
            this.Activated += (_, __) =>
            {
                try
                {
                    var root = this.Content as FrameworkElement;
                    var dragRegion = root?.FindName("DragRegion") as UIElement;
                    if (dragRegion != null)
                    {
                        this.SetTitleBar(dragRegion);
                    }
                }
                catch { }
            };

            // Window 没有 Loaded 事件，使用 LayoutUpdated 在首次布局后设置初始图标与标题栏颜色
            bool initialized = false;
            this.LayoutUpdated += (_, __) =>
            {
                if (initialized) return;
                initialized = true;
                try
                {
                    var root = this.Content as FrameworkElement;
                    var toggleBtn = root?.FindName("ToggleThemeButton") as Button;
                    if (toggleBtn != null && root != null)
                    {
                        var isDark = root.ActualTheme == ElementTheme.Dark;
                        var glyph = isDark ? "☀" : "☾";
                        toggleBtn.Content = new FontIcon { Glyph = glyph, FontFamily = new FontFamily("Segoe UI Symbol") };
                        // 确保标题栏颜色与初始主题一致
                        ApplyTitleBarColors(isDark);
                    }
                }
                catch { }
            };
        }

        [DllImport("user32.dll")]
        private static extern int GetSystemMetrics(int nIndex);

        [DllImport("user32.dll", SetLastError = true)]
        private static extern bool SetWindowPos(IntPtr hWnd, IntPtr hWndInsertAfter, int X, int Y, int cx, int cy, uint uFlags);

        private void ApplyTitleBarColors(bool dark)
        {
            try
            {
                var hwndForColors = WinRT.Interop.WindowNative.GetWindowHandle(this);
                var windowId = Microsoft.UI.Win32Interop.GetWindowIdFromWindow(hwndForColors);
                var appWindow = AppWindow.GetFromWindowId(windowId);
                if (appWindow != null)
                {
                    var titleBar = appWindow.TitleBar;
                    if (dark)
                    {
                        titleBar.BackgroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonBackgroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonForegroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonHoverBackgroundColor = Color.FromArgb(255, 30, 30, 30);
                        titleBar.ButtonPressedBackgroundColor = Color.FromArgb(255, 60, 60, 60);
                        titleBar.ButtonHoverForegroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonPressedForegroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.CloseButtonHoverBackgroundColor = Color.FromArgb(255, 232, 17, 35);
                        titleBar.CloseButtonPressedBackgroundColor = Color.FromArgb(255, 160, 0, 0);
                        titleBar.CloseButtonHoverForegroundColor = Color.FromArgb(255, 255, 255, 255);
                    }
                    else
                    {
                        // 浅色时使用浅背景、黑色前景
                        titleBar.BackgroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonBackgroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonForegroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonHoverBackgroundColor = Color.FromArgb(255, 230, 230, 230);
                        titleBar.ButtonPressedBackgroundColor = Color.FromArgb(255, 200, 200, 200);
                        titleBar.ButtonHoverForegroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonPressedForegroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.CloseButtonHoverBackgroundColor = Color.FromArgb(255, 232, 17, 35);
                        titleBar.CloseButtonPressedBackgroundColor = Color.FromArgb(255, 160, 0, 0);
                        titleBar.CloseButtonHoverForegroundColor = Color.FromArgb(255, 255, 255, 255);
                    }
                }
            }
            catch { }
        }

        private void ApplyTitleBarColors(bool isDark)
        {
            try
            {
                var hwndForColors = WinRT.Interop.WindowNative.GetWindowHandle(this);
                var windowId = Microsoft.UI.Win32Interop.Win32Interop.GetWindowIdFromWindow(hwndForColors);
                var appWindow = AppWindow.GetFromWindowId(windowId);
                if (appWindow != null)
                {
                    var titleBar = appWindow.TitleBar;
                    if (isDark)
                    {
                        // 深色主题
                        titleBar.BackgroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonBackgroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonForegroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonHoverBackgroundColor = Color.FromArgb(255, 30, 30, 30);
                        titleBar.ButtonPressedBackgroundColor = Color.FromArgb(255, 60, 60, 60);
                        titleBar.ButtonHoverForegroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonPressedForegroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.CloseButtonHoverBackgroundColor = Color.FromArgb(255, 232, 17, 35);
                        titleBar.CloseButtonPressedBackgroundColor = Color.FromArgb(255, 160, 0, 0);
                        titleBar.CloseButtonHoverForegroundColor = Color.FromArgb(255, 255, 255, 255);
                    }
                    else
                    {
                        // 浅色主题
                        titleBar.BackgroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonBackgroundColor = Color.FromArgb(255, 255, 255, 255);
                        titleBar.ButtonForegroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonHoverBackgroundColor = Color.FromArgb(255, 230, 230, 230);
                        titleBar.ButtonPressedBackgroundColor = Color.FromArgb(255, 200, 200, 200);
                        titleBar.ButtonHoverForegroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.ButtonPressedForegroundColor = Color.FromArgb(255, 0, 0, 0);
                        titleBar.CloseButtonHoverBackgroundColor = Color.FromArgb(255, 232, 17, 35);
                        titleBar.CloseButtonPressedBackgroundColor = Color.FromArgb(255, 160, 0, 0);
                        titleBar.CloseButtonHoverForegroundColor = Color.FromArgb(255, 255, 255, 255);
                    }
                }
            }
            catch { }
        }

        private void ToggleThemeButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var root = this.Content as FrameworkElement;
                if (root != null)
                {
                    // 切换窗口内容元素主题（局部切换）
                    var current = root.RequestedTheme;

                    root.RequestedTheme = current == ElementTheme.Dark ? ElementTheme.Light : ElementTheme.Dark;

                    // 更新系统标题栏颜色
                    ApplyTitleBarColors(root.RequestedTheme == ElementTheme.Dark);

                    // 更新按钮图标：如果现在是深色则显示太阳表示可切换到浅色
                    var toggleBtn = root.FindName("ToggleThemeButton") as Button;
                    if (toggleBtn != null)
                    {
                        var isDark = root.RequestedTheme == ElementTheme.Dark;
                        var glyph = isDark ? "☀" : "☾";
                        toggleBtn.Content = new FontIcon { Glyph = glyph, FontFamily = new FontFamily("Segoe UI Symbol") };
                    }
                }
            }
            catch { }
        }
    }
}
