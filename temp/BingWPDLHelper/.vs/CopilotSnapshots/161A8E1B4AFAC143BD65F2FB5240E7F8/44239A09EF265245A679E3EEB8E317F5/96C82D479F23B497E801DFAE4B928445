<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingWPDLHelper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BingWPDLHelper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="必应壁纸下载器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Fluent 风格自定义标题栏 -->
        <Border x:Name="AppTitleBar"
                Grid.Row="0"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="必应壁纸下载器"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Grid.Column="0" />

                <!-- 右侧按钮组，留出一定右侧间距以避免覆盖系统窗口控制按钮 -->
                <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,120,0">
                    <Button x:Name="ToggleThemeButton"
                            Click="ToggleThemeButton_Click"
                            ToolTipService.ToolTip="切换深浅模式"
                            Padding="8,4"
                            MinWidth="36">
                        <TextBlock Text="主题" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <!-- 主内容区，按需填充 -->
        </Grid>

    </Grid>
</Window>
