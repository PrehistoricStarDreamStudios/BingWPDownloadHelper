        private async System.Threading.Tasks.Task InitializeTodayUIAsync()
        {
            try
            {
                var root = this.Content as FrameworkElement;
                var left = root?.FindName("LeftNavList") as ListBox;
                if (left != null) left.SelectedIndex = 0;

                var http = new System.Net.Http.HttpClient();
                var url = "https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=en-US";
                var s = await http.GetStringAsync(url);
                using var doc = System.Text.Json.JsonDocument.Parse(s);
                var images = doc.RootElement.GetProperty("images");
                if (images.GetArrayLength() > 0)
                {
                    var first = images[0];
                    var urlBase = first.GetProperty("urlbase").GetString();
                    if (!string.IsNullOrEmpty(urlBase))
                    {
                        var full = "https://www.bing.com" + urlBase + "_UHD.jpg";
                        var img = new Microsoft.UI.Xaml.Media.Imaging.BitmapImage(new Uri(full));
                        var rootEl = this.Content as FrameworkElement;
                        var mainImg = rootEl?.FindName("MainImage") as Microsoft.UI.Xaml.Controls.Image;
                        if (mainImg != null) mainImg.Source = img;

                        // 在 UI 线程更新分段选择指示器位置（默认选择 BUHD）
                        _ = this.DispatcherQueue.TryEnqueue(Microsoft.UI.Dispatching.DispatcherQueuePriority.Normal, () =>
                        {
                            try
                            {
                                var seg = rootEl?.FindName("BUHD") as FrameworkElement;
                                var segGrid = rootEl?.FindName("SegGrid") as Grid;
                                var sel = rootEl?.FindName("SelIndicator") as Border;
                                var selTrans = rootEl?.FindName("SelTransform") as Microsoft.UI.Xaml.Media.TranslateTransform;
                                if (seg != null && sel != null && selTrans != null && segGrid != null)
                                {
                                    // 基于 segment 在 segGrid 中的位置计算 X 偏移，考虑相邻 segment 的负 margin 覆盖
                                    var t = seg.TransformToVisual(segGrid).TransformPoint(new Windows.Foundation.Point(0, 0));
                                    double overlapAdjustment = 0;
                                    // 如果使用的是右侧两个 segment 的 Margin=-2，那么需要对 X 做修正
                                    if (seg == (rootEl?.FindName("B1080") as FrameworkElement)) overlapAdjustment = -2;
                                    if (seg == (rootEl?.FindName("BUHD") as FrameworkElement)) overlapAdjustment = -4; // 两个 -2 叠加

                                    // 尝试使用内部按钮的宽度来计算更精确的高亮宽度
                                    double innerWidth = seg.ActualWidth;
                                    try
                                    {
                                        var btn = seg.FindName("Btn720") as FrameworkElement;
                                        if (btn == null) btn = seg.FindName("Btn1080") as FrameworkElement;
                                        if (btn == null) btn = seg.FindName("BtnUHD") as FrameworkElement;
                                        if (btn != null) innerWidth = btn.ActualWidth + 24; // 包括左右内边距
                                    }
                                    catch { }

                                    sel.Width = Math.Max(0, innerWidth - 4);
                                    selTrans.X = t.X + 2 + overlapAdjustment;
                                    sel.Opacity = 1.0;
                                }
                            }
                            catch { }
                        });
                    }
                }
            }
            catch { }
        }

        private void Seg_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var root = this.Content as FrameworkElement;
                var segGrid = root?.FindName("SegGrid") as Grid;
                var sel = root?.FindName("SelIndicator") as Border;
                var selTrans = root?.FindName("SelTransform") as Microsoft.UI.Xaml.Media.TranslateTransform;
                if (segGrid == null || sel == null || selTrans == null) return;

                FrameworkElement target = null;
                string buttonName = null;
                if (sender is Button b)
                {
                    buttonName = b.Name;
                    if (b.Name == "Btn720") target = root?.FindName("B720") as FrameworkElement;
                    else if (b.Name == "Btn1080") target = root?.FindName("B1080") as FrameworkElement;
                    else target = root?.FindName("BUHD") as FrameworkElement;
                }

                if (target != null)
                {
                    var pt = target.TransformToVisual(segGrid).TransformPoint(new Windows.Foundation.Point(0, 0));
                    // 考虑相邻 segment 的负 margin 导致的重叠，做微调
                    double overlapAdjustment = 0;
                    if (target == (root?.FindName("B1080") as FrameworkElement)) overlapAdjustment = -2;
                    if (target == (root?.FindName("BUHD") as FrameworkElement)) overlapAdjustment = -4;

                    // 使用内部按钮宽度以获得更精确的高亮宽度（fallback 为 target.ActualWidth）
                    double innerWidth = target.ActualWidth;
                    try
                    {
                        var btn = target.FindName("Btn720") as FrameworkElement;
                        if (btn == null) btn = target.FindName("Btn1080") as FrameworkElement;
                        if (btn == null) btn = target.FindName("BtnUHD") as FrameworkElement;
                        if (btn != null) innerWidth = btn.ActualWidth + 24; // 近似包含左右 Padding
                    }
                    catch { }

                    // 使高亮条宽度和 X 偏移考虑边距（左右各 2px）
                    double targetWidth = Math.Max(0, innerWidth - 4);
                    double targetX = pt.X + 2 + overlapAdjustment;

                    // 直接设置宽度与偏移，并做简单过渡（可由 config 控制）
                    if (AnimationEnabled && AnimationMs > 0)
                    {
                        AnimateSelIndicator(sel, selTrans, sel.Width, targetWidth, selTrans.X, targetX, AnimationMs);
                    }
                    else
                    {
                        sel.Width = targetWidth;
                        selTrans.X = targetX;
                        sel.Opacity = 1.0;
                    }

                    // 更新图片分辨率：根据所点击的分段构建后缀并重新请求
                    var mainImg = root?.FindName("MainImage") as Microsoft.UI.Xaml.Controls.Image;
                    if (mainImg != null)
                    {
                        string suffix = "_UHD.jpg";
                        if (buttonName == "Btn720") suffix = "_1280x720.jpg";
                        else if (buttonName == "Btn1080") suffix = "_1920x1080.jpg";

                        try
                        {
                            var http = new System.Net.Http.HttpClient();
                            var url = "https://www.bing.com/HPImageArchive.aspx?format=js&idx=0&n=1&mkt=en-US";
                            var s = http.GetStringAsync(url).Result;
                            using var doc = System.Text.Json.JsonDocument.Parse(s);
                            var images = doc.RootElement.GetProperty("images");
                            if (images.GetArrayLength() > 0)
                            {
                                var first = images[0];
                                var urlBase = first.GetProperty("urlbase").GetString();
                                if (!string.IsNullOrEmpty(urlBase))
                                {
                                    var full = "https://www.bing.com" + urlBase + suffix;
                                    mainImg.Source = new Microsoft.UI.Xaml.Media.Imaging.BitmapImage(new Uri(full));
                                }
                            }
                        }
                        catch { }
                    }
                }
            }
            catch { }
        }
