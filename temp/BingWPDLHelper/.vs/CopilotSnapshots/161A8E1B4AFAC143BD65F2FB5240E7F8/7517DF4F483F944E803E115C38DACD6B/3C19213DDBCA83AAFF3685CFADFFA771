        private void MaxButton_Click(object sender, RoutedEventArgs e)
        {
            try
            {
                var hwnd = WinRT.Interop.WindowNative.GetWindowHandle(this);
                // 使用 WM_SYSCOMMAND 进行最大化/还原，避免改变窗口样式导致全屏行为
                if (IsWindowMaximized(hwnd))
                {
                    SendMessage(hwnd, WM_SYSCOMMAND, new IntPtr(SC_RESTORE), IntPtr.Zero);
                    var root = this.Content as FrameworkElement;
                    var maxIcon = root?.FindName("MaxIcon") as TextBlock;
                    if (maxIcon != null) maxIcon.Text = "▢"; // 恢复为最大化图标
                    var maxBtn = root?.FindName("MaxButton") as Button;
                    if (maxBtn != null) Microsoft.UI.Xaml.Controls.ToolTipService.SetToolTip(maxBtn, "最大化");
                    try { HideNativeCaptionButtons(); } catch { }
                }
                else
                {
                    SendMessage(hwnd, WM_SYSCOMMAND, new IntPtr(SC_MAXIMIZE), IntPtr.Zero);
                    var root = this.Content as FrameworkElement;
                    var maxIcon = root?.FindName("MaxIcon") as TextBlock;
                    if (maxIcon != null) maxIcon.Text = "❐"; // 还原样式图标
                    var maxBtn = root?.FindName("MaxButton") as Button;
                    if (maxBtn != null) Microsoft.UI.Xaml.Controls.ToolTipService.SetToolTip(maxBtn, "还原");
                    try { HideNativeCaptionButtons(); } catch { }
                }
            }
            catch { }
        }

