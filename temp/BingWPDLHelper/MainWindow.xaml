<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingPaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BingPaper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="必应壁纸下载器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 - WinUI3 样式 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 目录折叠按钮（标题栏左侧） -->
            <Button x:Name="CollapseNavButtonLeft"
                    Click="CollapseNavButton_Click"
                    Grid.Column="0"
                    Width="46" Height="32"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    ToolTipService.ToolTip="折叠/展开目录">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- 拖拽区域 + 标题文字 -->
            <Grid x:Name="DragRegion" Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="必应壁纸下载器"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Grid>

            <!-- 占位（深浅色切换已移到设置页） -->
            <Border Grid.Column="2" Width="0" />
        </Grid>

        <!-- NavigationView 主容器，使用标题栏自定义按钮控制折叠 -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        CompactPaneLength="48"
                        OpenPaneLength="240"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="今日壁纸" Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="下载壁纸" Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置壁纸" Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="壁纸预览" Tag="5">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE726;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="软件设置" Tag="3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容区 -->
            <Frame x:Name="contentFrame">
                <Grid>
                    <!-- 今日壁纸页面 -->
                    <Grid x:Name="TodayHost" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Margin="5" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
                            <Image x:Name="MainImage" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock x:Name="ImageTitle" Grid.Row="1" Text="" HorizontalAlignment="Center" Margin="8,8,8,0" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                    </Grid>

                    <!-- 下载壁纸页面 -->
                    <ScrollViewer x:Name="DownloadHost" Visibility="Collapsed" Margin="8">
                        <StackPanel>
                            <TextBlock Text="下载壁纸" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <!-- 下载目录：自适应窗口宽度 -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="下载目录：" VerticalAlignment="Center" Grid.Column="0" />
                                <TextBox x:Name="DownloadFolderText" Grid.Column="1" IsReadOnly="False" HorizontalAlignment="Stretch" Margin="8,0" KeyDown="DownloadFolderText_KeyDown" />
                                <Button Grid.Column="2" Click="OpenFolderPicker_Click" ToolTipService.ToolTip="选择文件夹" Margin="8,0,0,0">
                                    <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="比例：" VerticalAlignment="Center" />
                                <ComboBox x:Name="AspectRatioCombo" Width="120" Margin="8,0" SelectionChanged="AspectRatioCombo_SelectionChanged" />
                                <TextBlock Text=" 分辨率：" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <ComboBox x:Name="ResolutionCombo" Width="220" Margin="8,0" />
                            </StackPanel>

                            <!-- 多线程下载选项：默认4，最高32 -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <TextBlock Text="下载线程数：" VerticalAlignment="Center" />
                                <ComboBox x:Name="DownloadThreadsCombo" Width="80" Margin="8,0,0,0" SelectedIndex="3">
                                    <ComboBoxItem Content="1" />
                                    <ComboBoxItem Content="2" />
                                    <ComboBoxItem Content="3" />
                                    <ComboBoxItem Content="4" />
                                    <ComboBoxItem Content="6" />
                                    <ComboBoxItem Content="8" />
                                    <ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="24" />
                                    <ComboBoxItem Content="32" />
                                </ComboBox>
                                <TextBlock Text="（1-32）" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                <!-- 分类选择预留位置（后续再给分类标签） -->
                                <TextBlock Text=" 分类：" VerticalAlignment="Center" Margin="24,0,0,0" />
                                <ComboBox x:Name="DownloadCategoryCombo" Width="160" Margin="8,0,0,0" SelectedIndex="0">
                                    <ComboBoxItem Content="全部" Tag="All" />
                                    <ComboBoxItem Content="（待添加分类）" Tag="Placeholder" IsEnabled="False" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <CheckBox x:Name="DownloadHistoryCheck" Content="下载历史壁纸" Checked="DownloadHistoryCheck_Checked" Unchecked="DownloadHistoryCheck_Unchecked" />
                                <TextBlock Text=" 起始日期：" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <ComboBox x:Name="YearCombo" Width="80" IsEnabled="False" Margin="8,0,0,0" SelectionChanged="DatePart_SelectionChanged" />
                                <ComboBox x:Name="MonthCombo" Width="80" IsEnabled="False" Margin="8,0,0,0" SelectionChanged="DatePart_SelectionChanged" />
                                <ComboBox x:Name="DayCombo" Width="80" IsEnabled="False" Margin="8,0,0,0" SelectionChanged="DatePart_SelectionChanged" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="开始下载" Click="StartDownloadButton_Click" Width="120" />
                            </StackPanel>

                            <TextBox x:Name="DownloadStatusText" TextWrapping="Wrap" Margin="0,8,0,0" AcceptsReturn="True" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="200" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 设置壁纸页面 -->
                    <Grid x:Name="SettingsHost" Visibility="Collapsed" Margin="8">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="设置壁纸" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                                <!-- 幻灯片目录：自适应窗口宽度 -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="幻灯片目录" VerticalAlignment="Center" Grid.Column="0" />
                                    <TextBox x:Name="SlideshowFolderText" Grid.Column="1" HorizontalAlignment="Stretch" Margin="8,0" IsReadOnly="False" />
                                    <Button Grid.Column="2" Click="OpenFolderPicker_Click" ToolTipService.ToolTip="选择文件夹" Margin="8,0,0,0">
                                        <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    </Button>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="切换间隔" VerticalAlignment="Center" Grid.Column="0" />
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                        <NumberBox x:Name="SlideshowInterval" Minimum="1" Maximum="86400" Value="1800" Width="140" />
                                        <TextBlock Text="秒" VerticalAlignment="Center" Margin="8,0,16,0" />
                                        <CheckBox x:Name="ShuffleCheck" Content="乱序" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="填充方式" VerticalAlignment="Center" Grid.Column="0" />
                                    <ComboBox x:Name="FillModeCombo" Grid.Column="1" HorizontalAlignment="Stretch" Margin="8,0,0,0" SelectedIndex="4">
                                        <ComboBoxItem Content="Center（居中）" Tag="Center" />
                                        <ComboBoxItem Content="Tile（平铺）" Tag="Tile" />
                                        <ComboBoxItem Content="Stretch（拉伸）" Tag="Stretch" />
                                        <ComboBoxItem Content="Fit（适应）" Tag="Fit" />
                                        <ComboBoxItem Content="Fill（填充）" Tag="Fill" />
                                        <ComboBoxItem Content="Span（跨屏）" Tag="Span" />
                                    </ComboBox>
                                </Grid>

                                <Button Content="应用设置" Click="ApplySlideshowButton_Click" Width="120" Margin="0,4,0,0" />
                                <TextBlock x:Name="SettingsStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 软件设置页面（增强版：含语言、主题、关闭行为、关闭按钮） -->
                    <Grid x:Name="AppSettingsHost" Visibility="Collapsed" Margin="8">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="软件设置" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                                <!-- 语言与地区 -->
                                <TextBlock Text="语言与地区" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="语言：" VerticalAlignment="Center" Width="80" />
                                    <ComboBox x:Name="LanguageCombo" Width="280" Margin="8,0,0,0" />
                                </StackPanel>

                                <!-- 显示模式与颜色主题（合并为一项） -->
                                <TextBlock Text="主题与外观" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                            <TextBlock Text="显示模式：" VerticalAlignment="Center" Width="90" />
                                            <ComboBox x:Name="ThemeModeCombo" Width="160" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                                <ComboBoxItem Content="浅色" Tag="Light" />
                                                <ComboBoxItem Content="深色" Tag="Dark" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="颜色主题：" VerticalAlignment="Center" Width="90" />
                                            <ComboBox x:Name="ColorThemeCombo" Width="160" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="ThemeCombo_SelectionChanged">
                                                <ComboBoxItem Content="跟随系统" Tag="System" />
                                                <ComboBoxItem Content="蓝色" Tag="Blue" />
                                                <ComboBoxItem Content="绿色" Tag="Green" />
                                                <ComboBoxItem Content="橙色" Tag="Orange" />
                                                <ComboBoxItem Content="紫色" Tag="Purple" />
                                                <ComboBoxItem Content="粉色" Tag="Pink" />
                                            </ComboBox>
                                        </StackPanel>
                                        <TextBlock Text="提示：修改后立即生效。" FontSize="12" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <!-- 开机自启 -->
                                <TextBlock Text="开机与启动" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" />
                                    <CheckBox x:Name="AutoStartHideCheck" Content="启动时最小化到托盘" Margin="24,0,0,0" />
                                </StackPanel>

                                <!-- 关闭行为 -->
                                <TextBlock Text="关闭行为" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="关闭按钮：" VerticalAlignment="Center" Width="80" />
                                    <ComboBox x:Name="CloseBehaviorCombo" Width="220" Margin="8,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="最小化到托盘" Tag="Tray" />
                                        <ComboBoxItem Content="退出程序" Tag="Exit" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <CheckBox x:Name="AskExitConfirmCheck" Content="关闭软件前询问确认" />
                                </StackPanel>

                                <!-- 下载设置 -->
                                <TextBlock Text="下载" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="默认线程数：" VerticalAlignment="Center" Width="80" />
                                    <ComboBox x:Name="SettingsDownloadThreadsCombo" Width="80" Margin="8,0,0,0" SelectedIndex="3">
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="3" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="6" />
                                        <ComboBoxItem Content="8" />
                                        <ComboBoxItem Content="12" />
                                        <ComboBoxItem Content="16" />
                                        <ComboBoxItem Content="24" />
                                        <ComboBoxItem Content="32" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- 历史保留的列表/API 配置 -->
                                <TextBlock Text="壁纸列表与 API" FontWeight="SemiBold" Margin="0,8,0,4" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="默认列表：" VerticalAlignment="Center" Width="80" />
                                    <ComboBox x:Name="DefaultListCombo" Width="280" Margin="8,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="本地列表" Tag="local" />
                                        <ComboBoxItem Content="sdnet.page.gd" Tag="sdnet.page.gd" IsEnabled="False" />
                                        <ComboBoxItem Content="worldno1steve.github.io" Tag="worldno1steve.github.io" IsEnabled="False" />
                                        <ComboBoxItem Content="sdnet.pages.dev" Tag="sdnet.pages.dev" IsEnabled="False" />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                    <TextBlock Text="API 获取：" VerticalAlignment="Center" Width="80" />
                                    <ComboBox x:Name="ApiSourceCombo" Width="280" Margin="8,0,0,0" SelectedIndex="0">
                                        <ComboBoxItem Content="必应" />
                                        <ComboBoxItem Content="----" IsEnabled="False" />
                                        <ComboBoxItem Content="----" IsEnabled="False" />
                                    </ComboBox>
                                </StackPanel>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="保存设置" Click="SaveSoftwareSettings_Click" Width="120" Margin="0,0,12,0" />
                                    <Button Content="关闭软件" Click="ExitAppButton_Click" Width="120" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                                </StackPanel>
                                <TextBlock x:Name="AppSettingsStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 关于页面（增强版：友情链接独立窗口、每日格言、小工具-优化内存） -->
                    <Grid x:Name="AboutHost" Visibility="Collapsed" Margin="8">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Stretch">

                                <!-- 标题区 -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Bing 壁纸" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock x:Name="AboutVersionText" Text="版本 b0.1" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                        <TextBlock Text="Bing 每日壁纸下载与管理工具，开源、轻量、跨平台兼容。" TextWrapping="Wrap" FontSize="13" />
                                    </StackPanel>
                                </Border>

                                <!-- 友情链接（系统默认浏览器打开） -->
                                <Expander Header="友情链接" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock Text="点击下方按钮在系统默认浏览器中打开：" TextWrapping="Wrap" Margin="0,4,0,8" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button x:Name="OpenLinksButton" Content="友情链接主页" Click="OpenLinksButton_Click" Margin="0,0,8,4" />
                                            <Button Content="必应" Click="OpenBingLink_Click" Margin="0,0,8,4" />
                                            <Button Content="项目 GitHub" Click="OpenProjectGit_Click" Margin="0,0,8,4" />
                                            <Button Content="B站" Click="OpenBili_Click" Margin="0,0,8,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- 每日格言 -->
                                <Expander Header="每日格言" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="MottoText" Text="点击下方按钮显示今日格言" TextWrapping="Wrap" FontSize="14" FontStyle="Italic" Margin="0,4,0,8" />
                                        <Button Content="显示今日格言" Click="ShowMottoButton_Click" />
                                    </StackPanel>
                                </Expander>

                                <!-- 小工具 -->
                                <Expander Header="实用小工具" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock Text="优化内存：将使用率较低的内存压缩至虚拟内存分页文件内。" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="12" />
                                        <Button Content="立即优化" Click="OptimizeMemoryButton_Click" />
                                    </StackPanel>
                                </Expander>

                                <!-- 关于作者 -->
                                <Expander Header="关于作者" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="B站" Click="OpenBili_Click" Margin="0,0,8,4" />
                                        <Button Content="邮箱" Click="OpenMail_Click" Margin="0,0,8,4" />
                                        <Button Content="GitHub" Click="OpenAuthorGit_Click" Margin="0,0,8,4" />
                                        <Button Content="X" Click="OpenAuthorX_Click" Margin="0,0,8,4" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 壁纸预览页面：1:1 裁剪 768x768，平铺展示，悬停放大，分类预留 -->
                    <Grid x:Name="WallpaperPreviewHost" Visibility="Collapsed" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="壁纸预览" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <!-- 分类预留区域 -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="分类：" VerticalAlignment="Center" />
                            <ComboBox x:Name="PreviewCategoryCombo" Width="160" Margin="8,0,0,0" SelectedIndex="0">
                                <ComboBoxItem Content="全部" Tag="All" />
                                <ComboBoxItem Content="（待添加分类）" Tag="Placeholder" IsEnabled="False" />
                            </ComboBox>
                            <Button x:Name="RefreshPreviewButton" Content="刷新预览" Click="RefreshPreviewButton_Click" Margin="12,0,0,0" />
                        </StackPanel>

                        <!-- 平铺壁纸缩略图 -->
                        <ScrollViewer Grid.Row="2" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="WallpaperPreviewItems">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Height="220" Margin="6" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}" Padding="0"
                                                PointerEntered="WallpaperThumb_PointerEntered" PointerExited="WallpaperThumb_PointerExited">
                                            <Grid>
                                                <!-- 裁剪后的中心 768x768 部分（缩小展示） -->
                                                <Image Source="{Binding ThumbSource}" Width="200" Height="200" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                                    <Image.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                                    </Image.RenderTransform>
                                                </Image>
                                                <!-- 文件名显示 -->
                                                <Border VerticalAlignment="Bottom" Background="#80000000" Padding="4,2">
                                                    <TextBlock Text="{Binding FileName}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                                </Border>
                                            </Grid>
