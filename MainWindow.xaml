<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingPaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="MainWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 48px：左 返回+侧栏切换 / 中 标题 / 右 主题切换+系统caption -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 返回按钮（与设计稿左侧 chevron-left 对应） -->
            <Button x:Name="BackButton"
                    Click="BackButton_Click"
                    Grid.Column="0"
                    Width="46" Height="46"
                    Margin="2,1,0,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- 汉堡菜单按钮（折叠/展开侧边栏，对应设计稿 panel-left-close） -->
            <Button x:Name="CollapseNavButtonLeft"
                    Click="CollapseNavButton_Click"
                    Grid.Column="1"
                    Width="46" Height="46"
                    Margin="0,1,0,1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    x:Uid="CollapseNavBtn">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- 拖拽区域 + 居中标题 -->
            <Grid x:Name="DragRegion" Grid.Column="2" Margin="12,0,0,0">
                <TextBlock x:Name="AppTitleText"
                           x:Uid="AppTitleText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           FontSize="13"
                           FontWeight="Normal"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- 主题切换按钮（放在系统caption按钮左侧） -->
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button x:Name="ToggleThemeButton"
                        Click="ToggleThemeButton_Click"
                        Width="46" Height="46"
                        Margin="0,1,0,1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        x:Uid="ToggleThemeBtn">
                    <FontIcon x:Name="ToggleIcon" Glyph="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                </Button>
                <!-- 预留系统 caption 按钮空间（最小化/最大化/关闭 约 138px） -->
                <Grid Width="138" />
            </StackPanel>
        </Grid>

        <!-- NavigationView + Frame 导航（WinUI3 标准架构） -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        CompactPaneLength="48"
                        OpenPaneLength="260"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavToday" Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDownload" Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPreview" Tag="5">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSetWallpaper" Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAbout" Tag="4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Tag="3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- WinUI3 标准页面导航 Frame -->
            <Frame x:Name="contentFrame" />
        </NavigationView>
    </Grid>
</Window>
