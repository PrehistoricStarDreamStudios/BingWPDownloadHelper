<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingPaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="MainWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 48px：WinUI3 标准标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Height="48"
              Padding="0,0,138,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 汉堡菜单按钮 -->
            <Button x:Name="CollapseNavButtonLeft"
                    Click="CollapseNavButton_Click"
                    Grid.Column="0"
                    Width="48" Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    x:Uid="CollapseNavBtn">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <!-- 拖拽区域 -->
            <Grid x:Name="DragRegion" Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Uid="AppTitleText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </Grid>

            <!-- 主题切换按钮 -->
            <Button x:Name="ToggleThemeButton"
                    Click="ToggleThemeButton_Click"
                    Grid.Column="2"
                    Width="48" Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    x:Uid="ToggleThemeBtn">
                <FontIcon x:Name="ToggleIcon" Glyph="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
        </Grid>

        <!-- NavigationView + Frame 导航（WinUI3 标准架构） -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        CompactPaneLength="48"
                        OpenPaneLength="240"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavToday" Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDownload" Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPreview" Tag="5">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSetWallpaper" Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAbout" Tag="4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Tag="3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- WinUI3 标准页面导航 Frame -->
            <Frame x:Name="contentFrame" />
        </NavigationView>
    </Grid>
</Window>