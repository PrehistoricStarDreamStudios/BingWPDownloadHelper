<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BingPaper.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BingPaper"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="MainWindow">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题栏 48px：Fluent 风格自定义标题栏 -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="CollapseNavButtonLeft"
                    Click="CollapseNavButton_Click"
                    Grid.Column="0"
                    Width="48" Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    x:Uid="CollapseNavBtn">
                <FontIcon Glyph="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>

            <Grid x:Name="DragRegion" Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Uid="AppTitleText"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           FontSize="14"
                           FontWeight="SemiBold" />
            </Grid>

            <Button x:Name="ToggleThemeButton"
                    Click="ToggleThemeButton_Click"
                    Grid.Column="2"
                    Width="48" Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    x:Uid="ToggleThemeBtn">
                <FontIcon x:Name="ToggleIcon" Glyph="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
            </Button>
        </Grid>

        <!-- NavigationView 主容器 -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsPaneOpen="True"
                        CompactPaneLength="48"
                        OpenPaneLength="240"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavToday" Tag="0">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavDownload" Tag="1">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavPreview" Tag="5">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A9;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavSetWallpaper" Tag="2">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="NavAbout" Tag="4">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Uid="NavSettings" Tag="3">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" FontFamily="Segoe MDL2 Assets" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!-- 内容区 -->
            <Frame x:Name="contentFrame">
                <Grid>
                    <!-- 今日壁纸页面 -->
                    <Grid x:Name="TodayHost" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Margin="5" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
                            <Image x:Name="MainImage" Stretch="UniformToFill" />
                        </Border>

                        <TextBlock x:Name="ImageTitle" Grid.Row="1" Text="" HorizontalAlignment="Center" Margin="8,8,8,0" FontSize="14" Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

                        <!-- 分辨率选择器 -->
                        <Grid x:Name="SegGrid" Grid.Row="2" Height="40" Margin="80,4,80,8" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 选中指示器 -->
                            <Border x:Name="SelIndicator"
                                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                                    CornerRadius="6"
                                    Height="32"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Opacity="0">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="SelTransform" X="0" Y="0" />
                                </Border.RenderTransform>
                            </Border>

                            <!-- 720p 按钮 -->
                            <Grid x:Name="B720" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Button x:Name="Btn720"
                                        Click="Seg_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="80"
                                        Height="34"
                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Content="720p" />
                            </Grid>

                            <!-- 1080p 按钮 -->
                            <Grid x:Name="B1080" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Button x:Name="Btn1080"
                                        Click="Seg_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="80"
                                        Height="34"
                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Content="1080p" />
                            </Grid>

                            <!-- UHD 按钮 -->
                            <Grid x:Name="BUHD" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Button x:Name="BtnUHD"
                                        Click="Seg_Click"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="80"
                                        Height="34"
                                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Content="UHD" />
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- 下载壁纸页面 -->
                    <ScrollViewer x:Name="DownloadHost" Visibility="Collapsed" Margin="8">
                        <StackPanel>
                            <TextBlock x:Uid="DownloadPageTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="DownloadFolderLabel" VerticalAlignment="Center" Grid.Column="0" />
                                <TextBox x:Name="DownloadFolderText" Grid.Column="1" IsReadOnly="False" HorizontalAlignment="Stretch" Margin="8,0" KeyDown="DownloadFolderText_KeyDown" />
                                <Button x:Uid="BrowseBtn" Grid.Column="2" Click="OpenFolderPicker_Click" Margin="8,0,0,0">
                                    <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock x:Uid="AspectRatioLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="AspectRatioCombo" Width="120" Margin="8,0" SelectionChanged="AspectRatioCombo_SelectionChanged" />
                                <TextBlock x:Uid="ResolutionLabel" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <ComboBox x:Name="ResolutionCombo" Width="220" Margin="8,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                <ToggleSwitch x:Name="DownloadHistoryCheck" x:Uid="DownloadHistoryChk" Toggled="DownloadHistoryCheck_Toggled" />
                                <TextBlock x:Uid="StartDateLabel" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <ComboBox x:Name="YearCombo" Width="80" IsEnabled="False" Margin="8,0,0,0" SelectionChanged="DatePart_SelectionChanged" />
                                <ComboBox x:Name="MonthCombo" Width="80" IsEnabled="False" Margin="8,0,0,0" SelectionChanged="DatePart_SelectionChanged" />
                                <ComboBox x:Name="DayCombo" Width="80" IsEnabled="False" Margin="8,0,0,0" SelectionChanged="DatePart_SelectionChanged" />
                            </StackPanel>

                            <Button x:Uid="StartDownloadBtn" Click="StartDownloadButton_Click" Width="120" Margin="0,8,0,0" />

                            <TextBox x:Name="DownloadStatusText" TextWrapping="Wrap" Margin="0,8,0,0" AcceptsReturn="True" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Height="200" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 设置壁纸页面 -->
                    <Grid x:Name="SettingsHost" Visibility="Collapsed" Margin="8">
                        <StackPanel>
                            <TextBlock x:Uid="SetWallpaperPageTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <Button x:Uid="OpenPersonalizationBtn" Click="OpenWindowsPersonalization_Click" Padding="16,10" Margin="0,0,0,16" />
                            <TextBlock x:Uid="PersonalizationHint" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="SlideshowFolderLabel" VerticalAlignment="Center" />
                                <TextBox x:Name="SlideshowFolderText" HorizontalAlignment="Stretch" Margin="8,0" IsReadOnly="False" />
                                <Button x:Uid="BrowseBtn2" Click="OpenFolderPicker_Click" Margin="8,0,0,0">
                                    <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                </Button>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="IntervalLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="SlideshowIntervalCombo" Width="160" Margin="8,0" SelectedIndex="2">
                                    <ComboBoxItem x:Uid="Interval1m" Tag="60" />
                                    <ComboBoxItem x:Uid="Interval10m" Tag="600" />
                                    <ComboBoxItem x:Uid="Interval30m" Tag="1800" />
                                    <ComboBoxItem x:Uid="Interval1h" Tag="3600" />
                                    <ComboBoxItem x:Uid="Interval6h" Tag="21600" />
                                    <ComboBoxItem x:Uid="Interval1d" Tag="86400" />
                                </ComboBox>
                                <ToggleSwitch x:Name="ShuffleCheck" x:Uid="ShuffleChk" Margin="12,0" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="FillModeLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="FillModeCombo" Width="240" Margin="8,0" SelectedIndex="4">
                                    <ComboBoxItem x:Uid="FillFill" Tag="Fill" />
                                    <ComboBoxItem x:Uid="FillFit" Tag="Fit" />
                                    <ComboBoxItem x:Uid="FillStretch" Tag="Stretch" />
                                    <ComboBoxItem x:Uid="FillTile" Tag="Tile" />
                                    <ComboBoxItem x:Uid="FillCenter" Tag="Center" />
                                    <ComboBoxItem x:Uid="FillSpan" Tag="Span" />
                                </ComboBox>
                            </StackPanel>

                            <Button x:Uid="ApplySettingsBtn" Click="ApplySlideshowButton_Click" Width="120" Margin="0,8,0,0" />
                            <TextBlock x:Name="SettingsStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    <!-- 软件设置页面 -->
                    <Grid x:Name="AppSettingsHost" Visibility="Collapsed" Margin="8">
                        <StackPanel>
                            <TextBlock x:Uid="AppSettingsPageTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <ToggleSwitch x:Name="AutoStartCheck" x:Uid="AutoStartChk" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="CloseBehaviorLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="CloseBehaviorCombo" Width="180" Margin="8,0" SelectedIndex="0">
                                    <ComboBoxItem x:Uid="CloseTray" Tag="Tray" />
                                    <ComboBoxItem x:Uid="CloseExit" Tag="Exit" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="ThemeModeLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThemeModeCombo" Width="140" Margin="8,0" SelectedIndex="0" SelectionChanged="ThemeMode_SelectionChanged">
                                    <ComboBoxItem x:Uid="ThemeSystem" Tag="System" />
                                    <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                                    <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                                </ComboBox>
                                <TextBlock x:Uid="ColorThemeLabel" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <ComboBox x:Name="ColorThemeCombo" Width="140" Margin="8,0" SelectedIndex="0" SelectionChanged="ColorTheme_SelectionChanged">
                                    <ComboBoxItem x:Uid="ColorSystem" Tag="System" />
                                    <ComboBoxItem x:Uid="ColorBlue" Tag="Blue" />
                                    <ComboBoxItem x:Uid="ColorGreen" Tag="Green" />
                                    <ComboBoxItem x:Uid="ColorOrange" Tag="Orange" />
                                    <ComboBoxItem x:Uid="ColorPurple" Tag="Purple" />
                                    <ComboBoxItem x:Uid="ColorPink" Tag="Pink" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="DownloadThreadsLabel" VerticalAlignment="Center" />
                                <NumberBox x:Name="DownloadThreadsBox" Minimum="1" Maximum="32" Value="4" Width="100" Margin="8,0" />
                                <TextBlock x:Uid="DownloadThreadsHint" VerticalAlignment="Center" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="LanguageLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="LanguageCombo" Width="220" Margin="8,0" SelectedIndex="0">
                                    <ComboBoxItem x:Uid="LangZhCN" Tag="zh-CN" />
                                    <ComboBoxItem x:Uid="LangZhHK" Tag="zh-HK" />
                                    <ComboBoxItem x:Uid="LangZhTW" Tag="zh-TW" />
                                    <ComboBoxItem x:Uid="LangEnUS" Tag="en-US" />
                                    <ComboBoxItem x:Uid="LangEnGB" Tag="en-GB" />
                                </ComboBox>
                                <TextBlock x:Name="LanguageRestartHint" Text="" VerticalAlignment="Center" Margin="8,0" Foreground="Orange" FontSize="12" Visibility="Collapsed" />
                            </StackPanel>

                            <!-- 外观（Fluent Design 背景材质） -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="BackdropTypeLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="BackdropTypeCombo" Width="160" Margin="8,0" SelectedIndex="0" SelectionChanged="BackdropType_SelectionChanged">
                                    <ComboBoxItem x:Uid="BackdropMica" Tag="Mica" />
                                    <ComboBoxItem x:Uid="BackdropAcrylic" Tag="Acrylic" />
                                    <ComboBoxItem Content="Aero（Win7 玻璃）" Tag="Aero" />
                                    <ComboBoxItem Content="LiquidGlass（iOS/MacOS）" Tag="LiquidGlass" />
                                    <ComboBoxItem x:Uid="BackdropNone" Tag="None" />
                                </ComboBox>
                                <ToggleSwitch x:Name="TransparentBackgroundSwitch" x:Uid="TransparentBackgroundChk" Margin="16,0,0,0" Toggled="TransparentBackground_Toggled" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <ToggleSwitch x:Name="AutoUpdateListCheck" x:Uid="AutoUpdateListChk" IsOn="True" />
                                <Button x:Name="CheckUpdateNowBtn" x:Uid="CheckUpdateNowBtn" Margin="12,0,0,0" Padding="12,5" Click="CheckUpdateNow_Click" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="DefaultListLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="DefaultListCombo" Width="320" Margin="8,0" SelectedIndex="0">
                                    <ComboBoxItem x:Uid="ListLocal" Tag="local" />
                                    <ComboBoxItem Content="sdnet.page.gd" Tag="sdnet.page.gd" IsEnabled="False" />
                                    <ComboBoxItem Content="worldno1steve.github.io" Tag="worldno1steve.github.io" IsEnabled="False" />
                                    <ComboBoxItem Content="sdnet.pages.dev" Tag="sdnet.pages.dev" IsEnabled="False" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock x:Uid="ApiSourceLabel" VerticalAlignment="Center" />
                                <ComboBox x:Name="ApiSourceCombo" Width="320" Margin="8,0" SelectedIndex="0">
                                    <ComboBoxItem x:Uid="ApiBing" />
                                    <ComboBoxItem Content="----" IsEnabled="False" />
                                    <ComboBoxItem Content="----" IsEnabled="False" />
                                </ComboBox>
                            </StackPanel>

                            <Button x:Uid="SaveSettingsBtn" Click="SaveSoftwareSettings_Click" Width="120" Margin="0,8,0,0" />
                            <TextBlock x:Name="AppSettingsStatusText" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- 关于页面（Fluent Design：标题卡片 + 多 Expander 折叠区） -->
                    <Grid x:Name="AboutHost" Visibility="Collapsed" Margin="8">
                        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel HorizontalAlignment="Stretch" Spacing="8" Margin="0,0,0,12">

                                <!-- 标题卡片：应用名 + 版本 + 简介 -->
                                <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,4">
                                    <StackPanel>
                                        <TextBlock x:Uid="AboutPageTitle" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock x:Name="AboutVersionText" x:Uid="AboutVersionLabel" FontSize="13"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" Margin="0,0,0,8" />
                                        <TextBlock x:Uid="AboutDescriptionText" TextWrapping="Wrap" FontSize="13" />
                                    </StackPanel>
                                </Border>

                                <!-- 友情链接 -->
                                <Expander x:Uid="AboutLinksExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock x:Uid="AboutLinksHint" TextWrapping="Wrap" Margin="0,4,0,8"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Button x:Uid="AboutLinksBtn" Click="OpenLinksButton_Click" Margin="0,0,8,4" />
                                            <Button x:Uid="AboutBingBtn" Click="OpenBingLink_Click" Margin="0,0,8,4" />
                                            <Button x:Uid="AboutProjectGitBtn" Click="OpenProjectGit_Click" Margin="0,0,8,4" />
                                            <Button x:Uid="AboutBiliBtn" Click="OpenBili_Click" Margin="0,0,8,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- 每日格言 -->
                                <Expander x:Uid="AboutMottoExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock x:Name="MottoText" x:Uid="AboutMottoHint" TextWrapping="Wrap" FontStyle="Italic" Margin="0,4,0,8" />
                                        <Button x:Uid="AboutShowMottoBtn" Click="ShowMottoButton_Click" />
                                    </StackPanel>
                                </Expander>

                                <!-- 实用小工具（内存优化） -->
                                <Expander x:Uid="AboutToolsExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <StackPanel HorizontalAlignment="Stretch">
                                        <TextBlock x:Uid="ToolOptimizeMemoryDesc" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="12" />
                                        <Button x:Uid="ToolOptimizeMemoryBtn" Click="OptimizeMemoryButton_Click" />
                                    </StackPanel>
                                </Expander>

                                <!-- 关于作者 -->
                                <Expander x:Uid="AboutAuthorExpander" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Uid="AboutAuthorBiliBtn" Click="OpenBili_Click" Margin="4" />
                                        <Button x:Uid="AboutMailBtn" Click="OpenMail_Click" Margin="4" />
                                        <Button Content="GitHub" Click="OpenAuthorGit_Click" Margin="4" />
                                        <Button Content="X" Click="OpenAuthorX_Click" Margin="4" />
                                    </StackPanel>
                                </Expander>

                                <!-- 关于本项目 -->
                                <Expander x:Uid="AboutProjectExpander" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button x:Uid="AboutProjectGitBtn2" Click="OpenProjectGit_Click" Margin="4" />
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- 壁纸预览页面（独立页面：多张壁纸平铺，1366x768 取中间 768x768 缩小显示） -->
                    <Grid x:Name="PreviewHost" Visibility="Collapsed" Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock x:Uid="PreviewPageTitle" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Uid="TagFilterLabel" VerticalAlignment="Center" Margin="24,0,0,0" />
                            <ComboBox x:Name="TagFilterCombo" Width="140" SelectionChanged="TagFilter_SelectionChanged" />
                            <TextBlock x:Name="PreviewCountText" Text="" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                        </StackPanel>

                        <GridView x:Name="PreviewGridView" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False" Padding="0"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  ContainerContentChanging="PreviewGridView_ContainerContentChanging">
                            <GridView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="240" Height="240" Margin="4" PointerEntered="PreviewItem_PointerEntered" PointerExited="PreviewItem_PointerExited">
                                        <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" />
                                        <Image x:Name="ItemImg" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5">
                                            <Image.RenderTransform>
                                                <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1" />
                                            </Image.RenderTransform>
                                        </Image>
                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#80000000" Padding="6,3">
                                            <TextBlock Text="{Binding Tags}" FontSize="11" Foreground="White" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </Grid>

                </Grid>
            </Frame>
        </NavigationView>
    </Grid>
</Window>
