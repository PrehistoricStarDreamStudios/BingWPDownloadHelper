<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BingPaper.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Margin="5" CornerRadius="12" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" Padding="4">
            <Image x:Name="MainImage" Stretch="UniformToFill" />
        </Border>

        <TextBlock x:Name="ImageTitle" Grid.Row="1" Text="" HorizontalAlignment="Center" Margin="8,8,8,0" FontSize="14"
                   Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

        <!-- 分辨率选择器 -->
        <Grid x:Name="SegGrid" Grid.Row="2" Height="40" Margin="80,4,80,8" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="SelIndicator"
                    Background="{ThemeResource SystemControlHighlightAccentBrush}"
                    CornerRadius="6"
                    Height="32"
                    Width="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="SelTransform" X="0" Y="0" />
                </Border.RenderTransform>
            </Border>

            <Grid x:Name="B720" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="Btn720"
                        Click="Seg_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="80"
                        Height="34"
                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="720p" />
            </Grid>

            <Grid x:Name="B1080" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="Btn1080"
                        Click="Seg_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="80"
                        Height="34"
                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="1080p" />
            </Grid>

            <Grid x:Name="BUHD" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Button x:Name="BtnUHD"
                        Click="Seg_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="80"
                        Height="34"
                        Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Content="UHD" />
            </Grid>
        </Grid>
    </Grid>
</Page>