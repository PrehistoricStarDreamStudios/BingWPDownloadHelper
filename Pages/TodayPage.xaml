<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BingPaper.Pages.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,24,32,32" MaxWidth="1100">

            <!-- 页面标题 -->
            <TextBlock Text="今日壁纸" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"
                       Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />

            <!-- 16:9 大图展示区域 -->
            <Border CornerRadius="8" Padding="4"
                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="2">
                <Grid>
                    <Image x:Name="MainImage" Stretch="UniformToFill" Height="450" />
                    <TextBlock Text="今日壁纸展示区域" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               x:Name="PlaceholderText" Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- 分辨率分段选择器 -->
            <Grid x:Name="SegGrid" Height="40" Margin="0,16,0,8" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="SelIndicator"
                        Background="{ThemeResource SystemControlHighlightAccentBrush}"
                        CornerRadius="6"
                        Height="32"
                        Width="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SelTransform" X="0" Y="0" />
                    </Border.RenderTransform>
                </Border>

                <Grid x:Name="B720" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Button x:Name="Btn720"
                            Click="Seg_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="80"
                            Height="34"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Content="720p" />
                </Grid>

                <Grid x:Name="B1080" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Button x:Name="Btn1080"
                            Click="Seg_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="80"
                            Height="34"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Content="1080p" />
                </Grid>

                <Grid x:Name="BUHD" Grid.Column="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Button x:Name="BtnUHD"
                            Click="Seg_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="80"
                            Height="34"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Content="UHD" />
                </Grid>
            </Grid>

            <!-- 信息卡片：标题 / 版权 -->
            <Border Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" CornerRadius="8" Padding="20" Margin="0,8,0,0">
                <StackPanel Spacing="6">
                    <TextBlock Text="壁纸信息" FontSize="13"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
                    <TextBlock x:Name="ImageTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
