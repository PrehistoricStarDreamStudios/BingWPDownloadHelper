<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BingPaper.Pages.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SettingsHeaderText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,8" />
        </Style>
        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SettingsItemTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,8,32,32" MaxWidth="800">

            <!-- 页面标题 -->
            <TextBlock x:Uid="AppSettingsPageTitle" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20" />

            <!-- 常规 -->
            <TextBlock Style="{StaticResource SettingsHeaderText}" Text="常规" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="AutoStartChk" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="开机时自动启动本软件" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutoStartCheck" Grid.Column="1" Toggled="AutoStartCheck_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="CloseBehaviorLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="选择关闭窗口时的行为" />
                    </StackPanel>
                    <ComboBox x:Name="CloseBehaviorCombo" Grid.Column="1" Width="160" SelectedIndex="0" SelectionChanged="CloseBehaviorCombo_SelectionChanged">
                        <ComboBoxItem x:Uid="CloseTray" Tag="Tray" />
                        <ComboBoxItem x:Uid="CloseExit" Tag="Exit" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 外观 -->
            <TextBlock Style="{StaticResource SettingsHeaderText}" Text="外观" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="ThemeModeLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="选择应用主题" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeModeCombo" Grid.Column="1" Width="140" SelectedIndex="0" SelectionChanged="ThemeMode_SelectionChanged">
                        <ComboBoxItem x:Uid="ThemeSystem" Tag="System" />
                        <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                        <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="ColorThemeLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="选择应用强调色" />
                    </StackPanel>
                    <ComboBox x:Name="ColorThemeCombo" Grid.Column="1" Width="140" SelectedIndex="0" SelectionChanged="ColorTheme_SelectionChanged">
                        <ComboBoxItem x:Uid="ColorSystem" Tag="System" />
                        <ComboBoxItem x:Uid="ColorBlue" Tag="Blue" />
                        <ComboBoxItem x:Uid="ColorGreen" Tag="Green" />
                        <ComboBoxItem x:Uid="ColorOrange" Tag="Orange" />
                        <ComboBoxItem x:Uid="ColorPurple" Tag="Purple" />
                        <ComboBoxItem x:Uid="ColorPink" Tag="Pink" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="BackdropTypeLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="选择窗口背景效果" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="BackdropTypeCombo" Width="160" SelectedIndex="0" SelectionChanged="BackdropType_SelectionChanged">
                            <ComboBoxItem x:Uid="BackdropMica" Tag="Mica" />
                            <ComboBoxItem x:Uid="BackdropAcrylic" Tag="Acrylic" />
                            <ComboBoxItem Content="Aero" Tag="Aero" />
                            <ComboBoxItem Content="LiquidGlass" Tag="LiquidGlass" />
                            <ComboBoxItem x:Uid="BackdropNone" Tag="None" />
                        </ComboBox>
                        <ToggleSwitch x:Name="TransparentBackgroundSwitch" x:Uid="TransparentBackgroundChk" Toggled="TransparentBackground_Toggled" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 下载 -->
            <TextBlock Style="{StaticResource SettingsHeaderText}" Text="下载" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="DownloadThreadsLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" x:Uid="DownloadThreadsHint" />
                    </StackPanel>
                    <NumberBox x:Name="DownloadThreadsBox" Grid.Column="1" Minimum="1" Maximum="32" Value="4" Width="100" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="ApiSourceLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="选择壁纸数据来源" />
                    </StackPanel>
                    <ComboBox x:Name="ApiSourceCombo" Grid.Column="1" Width="220" SelectedIndex="0">
                        <ComboBoxItem x:Uid="ApiBing" />
                        <ComboBoxItem Content="----" IsEnabled="False" />
                        <ComboBoxItem Content="----" IsEnabled="False" />
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="DefaultListLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="选择默认壁纸列表来源" />
                    </StackPanel>
                    <ComboBox x:Name="DefaultListCombo" Grid.Column="1" Width="220" SelectedIndex="0">
                        <ComboBoxItem x:Uid="ListLocal" Tag="local" />
                        <ComboBoxItem Content="sdnet.page.gd" Tag="sdnet.page.gd" IsEnabled="False" />
                        <ComboBoxItem Content="worldno1steve.github.io" Tag="worldno1steve.github.io" IsEnabled="False" />
                        <ComboBoxItem Content="sdnet.pages.dev" Tag="sdnet.pages.dev" IsEnabled="False" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 语言 -->
            <TextBlock Style="{StaticResource SettingsHeaderText}" Text="语言" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="LanguageLabel" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="更改显示语言需重启应用" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Width="220" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem x:Uid="LangZhCN" Tag="zh-CN" />
                        <ComboBoxItem x:Uid="LangZhHK" Tag="zh-HK" />
                        <ComboBoxItem x:Uid="LangZhTW" Tag="zh-TW" />
                        <ComboBoxItem x:Uid="LangEnUS" Tag="en-US" />
                        <ComboBoxItem x:Uid="LangEnGB" Tag="en-GB" />
                    </ComboBox>
                </Grid>
            </Border>
            <TextBlock x:Name="LanguageRestartHint" Text="" Foreground="Orange" FontSize="12" Visibility="Collapsed" Margin="0,4,0,0" />

            <!-- 更新 -->
            <TextBlock Style="{StaticResource SettingsHeaderText}" Text="更新" />
            <Border Style="{StaticResource SettingsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource SettingsItemTitle}" x:Uid="AutoUpdateListChk" />
                        <TextBlock Style="{StaticResource SettingsDescription}" Text="每日从 GitHub 拉取并补充未分类壁纸" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                        <ToggleSwitch x:Name="AutoUpdateListCheck" IsOn="True" />
                        <Button x:Name="CheckUpdateNowBtn" x:Uid="CheckUpdateNowBtn" Padding="16,8" Click="CheckUpdateNow_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 保存按钮 -->
            <Button x:Uid="SaveSettingsBtn" Click="SaveSoftwareSettings_Click" Width="160" Margin="0,24,0,0" HorizontalAlignment="Left" Padding="16,10" />
            <TextBlock x:Name="AppSettingsStatusText" Margin="0,8,0,0" />

        </StackPanel>
    </ScrollViewer>
</Page>
