<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BingPaper.Pages.SetWallpaperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Margin="8">
        <TextBlock x:Uid="SetWallpaperPageTitle" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <Button x:Uid="OpenPersonalizationBtn" Click="OpenWindowsPersonalization_Click" Padding="16,10" Margin="0,0,0,16" />
        <TextBlock x:Uid="PersonalizationHint" Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock x:Uid="SlideshowFolderLabel" VerticalAlignment="Center" />
            <TextBox x:Name="SlideshowFolderText" HorizontalAlignment="Stretch" Margin="8,0" IsReadOnly="False" />
            <Button x:Uid="BrowseBtn2" Click="OpenFolderPicker_Click" Margin="8,0,0,0">
                <FontIcon Glyph="&#xE8DA;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
            </Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock x:Uid="IntervalLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="SlideshowIntervalCombo" Width="160" Margin="8,0" SelectedIndex="2">
                <ComboBoxItem x:Uid="Interval1m" Tag="60" />
                <ComboBoxItem x:Uid="Interval10m" Tag="600" />
                <ComboBoxItem x:Uid="Interval30m" Tag="1800" />
                <ComboBoxItem x:Uid="Interval1h" Tag="3600" />
                <ComboBoxItem x:Uid="Interval6h" Tag="21600" />
                <ComboBoxItem x:Uid="Interval1d" Tag="86400" />
            </ComboBox>
            <ToggleSwitch x:Name="ShuffleCheck" x:Uid="ShuffleChk" Margin="12,0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <TextBlock x:Uid="FillModeLabel" VerticalAlignment="Center" />
            <ComboBox x:Name="FillModeCombo" Width="240" Margin="8,0" SelectedIndex="4">
                <ComboBoxItem x:Uid="FillFill" Tag="Fill" />
                <ComboBoxItem x:Uid="FillFit" Tag="Fit" />
                <ComboBoxItem x:Uid="FillStretch" Tag="Stretch" />
                <ComboBoxItem x:Uid="FillTile" Tag="Tile" />
                <ComboBoxItem x:Uid="FillCenter" Tag="Center" />
                <ComboBoxItem x:Uid="FillSpan" Tag="Span" />
            </ComboBox>
        </StackPanel>

        <Button x:Uid="ApplySettingsBtn" Click="ApplySlideshowButton_Click" Width="120" Margin="0,8,0,0" />
        <TextBlock x:Name="SettingsStatusText" Margin="0,8,0,0" TextWrapping="Wrap" />
    </StackPanel>
</Page>